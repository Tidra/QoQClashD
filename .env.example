# QoQClashD 运行时环境变量模板
# 复制为 .env 或直接传给 docker/进程。全部可省略——括号里是代码默认值。
# 注意：这些变量都不进前端，全部由 server/config.ts 在运行时读取。

# 面板监听地址（默认 127.0.0.1 / 5173；容器内通常为 0.0.0.0 / 80）
PANEL_HOST=127.0.0.1
PANEL_PORT=5173

# 运行时根目录：data/ 与 kernel/ 都相对它解析（默认当前工作目录）
QOQCLASHD_HOME=

# 数据与内核目录（默认 <root>/data、<root>/kernel）
DATA_DIR=
CORE_STORAGE_DIR=

# 直接指定已有内核二进制（默认 <CORE_STORAGE_DIR>/mihomo[.exe]）
MIHOMO_BINARY=

# 内核 API 端口与面板密码都不走环境变量：端口在设置页改、密码在首屏创建，两者共用
# 同一个值，统一存在 data/qoqclashd.sqlite 里。内核地址固定为本机回环。
