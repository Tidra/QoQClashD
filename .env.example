# QoQClashD 环境变量模板
# 复制为 .env 并按需修改。所有变量均有默认值（见 src/config/env.ts）。
# 注意：这些变量不带 VITE_ 前缀，由 Docker 运行环境注入，
# 构建时通过 Vite define 读取并暴露为 __ENV__。

# 核心二进制存储位置（相对程序目录）
CORE_STORAGE_DIR=./core

# 数据存储位置：配置、订阅、节点等（相对程序目录）
DATA_DIR=./data

# 面板服务端口（Dockerfile 中 Caddy 监听端口）
PANEL_PORT=80

# Mihomo 核心 API 地址
API_HOST=http://127.0.0.1:9090

# 核心与面板共用的认证密钥（Bearer Token）。
# 为空时，首次进入面板需手动设置密码。
API_SECRET=
