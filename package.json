{
  "name": "qoqclashd",
  "version": "0.1.0",
  "description": "Mihomo 代理控制面板：内置内核托管、节点/订阅/分流配置与一键下发",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:cdn-fonts": "FONT=cdn vite build",
    "build:firasans-only": "FONT=firasans vite build",
    "build:misans-only": "FONT=misans vite build",
    "build:no-fonts": "FONT=none vite build",
    "build:pingfang-only": "FONT=pingfang vite build",
    "build:sarasa-only": "FONT=sarasa vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --external:yaml --external:sql.js --external:tree-kill --external:ws --outfile=dist-server/server.js",
    "dev": "node scripts/dev-all.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "format": "prettier --write src/",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "node dist-server/server.js",
    "test": "pnpm -r test",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "@metacubexd/agent": "workspace:*",
    "@metacubexd/config-editor": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.35",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@types/reconnectingwebsocket": "^1.0.10",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "countup.js": "^2.10.1",
    "daisyui": "^5.7.8",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "h3": "^1.15.4",
    "husky": "^9.1.7",
    "ipaddr.js": "^2.4.0",
    "ky": "^2.1.0",
    "lint-staged": "^17.2.0",
    "lodash": "^4.18.1",
    "mmdb-lib": "^3.0.3",
    "p-limit": "^7.3.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-bytes": "^7.1.1",
    "reconnectingwebsocket": "^1.0.0",
    "sort-package-json": "^4.0.0",
    "subsetted-fonts": "1.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3",
    "uuid": "^14.0.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8",
    "vuedraggable": "^4.1.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "comment:dependencies": "dependencies 只放 dist-server/server.js 运行时真要 require 的包，也就是 build:server 的四个 esbuild external：sql.js / tree-kill / ws / yaml。其余一律 devDependencies：前端库被 Vite 打进 dist/，h3 和两个 workspace 包被 esbuild 打进 bundle，都不进最终镜像。放错位置会直接加大镜像。"
}
