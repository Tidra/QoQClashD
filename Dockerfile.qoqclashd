# Compatibility filename. Use the same unified server image as Dockerfile.
FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/agent/package.json packages/agent/package.json
COPY packages/config-editor/package.json packages/config-editor/package.json
COPY src ./src
COPY public ./public
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY server ./server
COPY packages/agent packages/agent
COPY packages/config-editor packages/config-editor
RUN pnpm install --frozen-lockfile
RUN pnpm build && pnpm build:server

FROM node:22-alpine
ENV NODE_ENV=production PANEL_HOST=0.0.0.0 PANEL_PORT=80
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dist-server ./dist-server
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages/agent/package.json ./packages/agent/package.json
COPY --from=builder /app/packages/config-editor/package.json ./packages/config-editor/package.json
EXPOSE 80
VOLUME ["/app/data", "/app/kernel"]
CMD ["node", "dist-server/server.js"]
